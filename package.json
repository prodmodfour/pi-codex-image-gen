{
  "name": "pi-codex-image-gen",
  "version": "0.0.0",
  "description": "Pi extension that generates images through Codex ChatGPT auth without OpenAI API-key billing.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prodmodfour/pi-codex-image-gen.git"
  },
  "bugs": {
    "url": "https://github.com/prodmodfour/pi-codex-image-gen/issues"
  },
  "homepage": "https://github.com/prodmodfour/pi-codex-image-gen#readme",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-skill",
    "codex",
    "openai-codex",
    "codex-image-generation",
    "image-generation",
    "chatgpt"
  ],
  "files": [
    "extensions",
    "skills",
    "src",
    "docs",
    "test",
    "scripts",
    ".github/workflows",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE.md",
    "SECURITY.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/codex-image-gen.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "quality": "bash scripts/quality-gate.sh",
    "check:shell": "bash scripts/check-shell-syntax.sh",
    "guard:secrets": "bash scripts/check-no-secrets.sh",
    "guard:generated": "bash scripts/check-no-generated-private-files.sh",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "build": "npm run typecheck",
    "pack:check": "node scripts/check-package-contents.mjs",
    "smoke:codex-image": "node scripts/smoke-real-codex-image.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "typescript": "^5.7.3"
  }
}
